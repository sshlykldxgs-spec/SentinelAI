# Copy to backend/.env on your own machine; do not commit the resulting file.
# Leave the placeholder unchanged for Demo/Replay; Live requires your own key.
OPENAI_API_KEY=replace-with-your-own-key
OPENAI_MODEL=deepseek-chat
# DeepSeek OpenAI-compatible Chat Completions endpoint (not Responses).
OPENAI_BASE_URL=https://api.deepseek.com/v1
# Legacy MODEL_TIMEOUT_SECONDS is optional fallback for stages without explicit values.
# All stage timeouts are bounded to 1-120s; SDK and outer deadlines agree.
PLANNER_TIMEOUT_SECONDS=60
RESEARCH_TIMEOUT_SECONDS=120
ANALYST_TIMEOUT_SECONDS=90
REVIEWER_TIMEOUT_SECONDS=120
ACTION_TIMEOUT_SECONDS=120
# Executor recovery: 0 disables, 1 permits one structural-output correction.
# With SDK retries disabled it also recovers transport errors including HTTP 429.
MODEL_MAX_RETRIES=1
# SDK transport retries: 0 or 1; defaults to MODEL_MAX_RETRIES when unset.
# Transport errors are not retried again by the executor when SDK recovery is enabled.
MODEL_SDK_MAX_RETRIES=1
# 0 omits max_tokens from requests; the provider still enforces its own limits.
MODEL_MAX_OUTPUT_TOKENS=0
TASK_TIMEOUT_SECONDS=300
# 0 disables the application's task token budget. Usage is still recorded.
TASK_TOKEN_BUDGET=0
